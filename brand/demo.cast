{"version": 2, "width": 84, "height": 86, "timestamp": 1786513541, "idle_time_limit": 3.0, "title": "Candor \u2014 Wave 1 demo"}
[0.104338, "o", "\r\n> candor@0.1.0 demo\r\n> tsx src/demo.ts\r\n\r\n"]
[0.105021, "o", "\u001b[1G"]
[0.105071, "o", "\u001b[0K"]
[0.288293, "o", "\r\n\u001b[1mCANDOR\u001b[0m \u001b[2m— privacy-preserving proof-of-liabilities on Midnight\u001b[0m\r\n"]
[0.288567, "o", "\u001b[2mWave 1 demo · compiled contract, in-process · no proofs generated\u001b[0m\r\n\r\n\u001b[1m\u001b[36m1.\u001b[0m  \u001b[1mThe issuer's private book\u001b[0m\r\n\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[0.303362, "o", "  Alice       1,400,000\r\n"]
[0.303479, "o", "  Bob           320,500\r\n  Carol          78,000\r\n  Dave            5,200\r\n"]
[0.310838, "o", "  \u001b[2m────────────────────\u001b[0m\r\n"]
[0.311081, "o", "  total       1,803,700\r\n\r\n  \u001b[2mThis table never leaves the issuer. Only its root is published.\u001b[0m\r\n"]
[1.812517, "o", "\r\n\u001b[1m\u001b[36m2.\u001b[0m  \u001b[1mIssuer publishes — publish_solvency()\u001b[0m\r\n"]
[1.812786, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[1.847677, "o", "  liabilities_root      bb08141113e1844d…e0f24e91\r\n"]
[1.849484, "o", "  declared_liabilities  1,803,700\r\n"]
[1.851147, "o", "  committed_reserves    1,900,000  \u001b[33m[attested, not proven]\u001b[0m\r\n"]
[1.852619, "o", "  solvent               \u001b[32mtrue\u001b[0m\r\n\r\n  \u001b[2mFour public fields. No names, no addresses, no per-customer balances.\u001b[0m\r\n"]
[3.353543, "o", "\r\n\u001b[1m\u001b[36m3.\u001b[0m  \u001b[1mEach customer verifies privately — verify_inclusion()\u001b[0m\r\n"]
[3.353698, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[3.367517, "o", "  Alice    \u001b[32m✓ COVERED\u001b[0m\r\n"]
[3.899633, "o", "  Bob      \u001b[32m✓ COVERED\u001b[0m\r\n"]
[4.431476, "o", "  Carol    \u001b[32m✓ COVERED\u001b[0m\r\n"]
[4.968305, "o", "  Dave     \u001b[32m✓ COVERED\u001b[0m\r\n"]
[5.493117, "o", "\r\n  \u001b[2mBalance and secret stay in the witness. The circuit discloses one boolean.\u001b[0m\r\n"]
[6.993569, "o", "\r\n\u001b[1m\u001b[36m4.\u001b[0m  \u001b[1mIssuer republishes a root that drops Carol\u001b[0m\r\n"]
[6.993718, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[7.001949, "o", "  \u001b[2mnew root 569f3acc77309a4b…5be69aeb\u001b[0m\r\n"]
[7.002068, "o", "  \u001b[2mdeclared 1,725,700 — 78,000 lower\u001b[0m\r\n\r\n"]
[7.007557, "o", "  Alice    \u001b[32m✓ COVERED\u001b[0m\r\n"]
[7.541367, "o", "  Bob      \u001b[32m✓ COVERED\u001b[0m\r\n"]
[8.070484, "o", "  Carol    \u001b[31m✗ NOT INCLUDED\u001b[0m\r\n"]
[8.600208, "o", "  Dave     \u001b[32m✓ COVERED\u001b[0m\r\n"]
[9.124637, "o", "\r\n  \u001b[33mCarol detects her own omission. Everyone else is unaffected.\u001b[0m\r\n"]
[9.124773, "o", "  \u001b[2mHonest framing: this lets a customer catch being dropped. It does not\u001b[0m\r\n  \u001b[2mstop an issuer from dropping a customer who never checks.\u001b[0m\r\n"]
[11.379368, "o", "\r\n\u001b[1m\u001b[36m5.\u001b[0m  \u001b[1mIssuer keeps every customer but shaves the total\u001b[0m\r\n\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[11.385575, "o", "  \u001b[2msame root bb08141113e1844d…e0f24e91 — nobody removed\u001b[0m\r\n"]
[11.385663, "o", "  \u001b[2mdeclared 1,303,700 instead of 1,803,700\u001b[0m\r\n\r\n"]
[11.392665, "o", "  Alice    \u001b[31m✗ NOT INCLUDED\u001b[0m\r\n"]
[11.93099, "o", "  Bob      \u001b[31m✗ NOT INCLUDED\u001b[0m\r\n"]
[12.468389, "o", "  Carol    \u001b[31m✗ NOT INCLUDED\u001b[0m\r\n"]
[13.02136, "o", "  Dave     \u001b[31m✗ NOT INCLUDED\u001b[0m\r\n"]
[13.545346, "o", "\r\n  \u001b[33mEvery customer catches it — the tree commits to its own total.\u001b[0m\r\n  \u001b[2mEach node hashes its subtotal alongside its children, so restating\u001b[0m\r\n"]
[13.545404, "o", "  \u001b[2mthe sum moves the root. A plain membership tree could not see this.\u001b[0m\r\n"]
[15.804024, "o", "\r\n\u001b[1m\u001b[36m6.\u001b[0m  \u001b[1mAuditor reads the aggregate — auditor_view()\u001b[0m\r\n\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[15.807219, "o", "  declared_liabilities  1,803,700\r\n  solvent               \u001b[32mtrue\u001b[0m\r\n\r\n  \u001b[2mThe aggregate is public by construction — not a privileged view.\u001b[0m\r\n"]
[17.312212, "o", "\r\n\u001b[1m\u001b[36m7.\u001b[0m  \u001b[1mIssuer cannot publish while insolvent\u001b[0m\r\n\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n  declaring 1,803,701 against reserves of 1,803,700…\r\n  \u001b[32mrejected\u001b[0m — failed assert: insolvent\r\n\r\n\u001b[2mSimplifications, stated plainly: reserves are an attested number, not proven\u001b[0m\r\n\u001b[2mon-chain ownership. The tree does bind its own total, but a customer still\u001b[0m\r\n\u001b[2mhas to check: omission is detectable, not impossible.\u001b[0m\r\n\r\n"]
[17.334136, "o", "\u001b[1G\u001b[0K⠙"]
[17.335233, "o", "\u001b[1G"]
[17.335357, "o", "\u001b[0K"]
