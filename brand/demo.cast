{"version": 2, "width": 84, "height": 101, "timestamp": 1786525068, "idle_time_limit": 3.0, "title": "Candor \u2014 Wave 1 demo"}
[0.095922, "o", "\r\n> candor@0.1.0 demo\r\n> tsx src/demo.ts\r\n\r\n"]
[0.096559, "o", "\u001b[1G\u001b[0K"]
[0.276625, "o", "\r\n\u001b[1mCANDOR\u001b[0m \u001b[2m— privacy-preserving proof-of-liabilities on Midnight\u001b[0m\r\n"]
[0.276779, "o", "\u001b[2mWave 1 demo · compiled contract, in-process · no proofs generated\u001b[0m\r\n"]
[0.276823, "o", "\r\n\u001b[1m\u001b[36m1.\u001b[0m  \u001b[1mThe issuer's private book\u001b[0m\r\n"]
[0.276866, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[0.290817, "o", "  Alice       1,400,000\r\n"]
[0.290907, "o", "  Bob           320,500\r\n"]
[0.290961, "o", "  Carol          78,000\r\n"]
[0.290996, "o", "  Dave            5,200\r\n"]
[0.295665, "o", "  \u001b[2m────────────────────\u001b[0m\r\n"]
[0.2958, "o", "  total       1,803,700\r\n"]
[0.295863, "o", "\r\n  \u001b[2mThis table never leaves the issuer. Only its root is published.\u001b[0m\r\n"]
[1.597461, "o", "\r\n\u001b[1m\u001b[36m2.\u001b[0m  \u001b[1mIssuer publishes — publish_solvency()\u001b[0m\r\n"]
[1.597574, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[1.63142, "o", "  liabilities_root      bb08141113e1844d…e0f24e91\r\n"]
[1.632517, "o", "  declared_liabilities  1,803,700\r\n"]
[1.633597, "o", "  committed_reserves    1,900,000  \u001b[33m[attested, not proven]\u001b[0m\r\n"]
[1.634884, "o", "  solvent               \u001b[32mtrue\u001b[0m\r\n\r\n  \u001b[2mFour public fields. No names, no addresses, no per-customer balances.\u001b[0m\r\n"]
[2.936425, "o", "\r\n\u001b[1m\u001b[36m3.\u001b[0m  \u001b[1mEach customer verifies privately\u001b[0m\r\n"]
[2.936551, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[2.947036, "o", "  Alice    \u001b[32m✓ COVERED\u001b[0m\r\n"]
[3.412368, "o", "  Bob      \u001b[32m✓ COVERED\u001b[0m\r\n"]
[3.874104, "o", "  Carol    \u001b[32m✓ COVERED\u001b[0m\r\n"]
[4.336557, "o", "  Dave     \u001b[32m✓ COVERED\u001b[0m\r\n"]
[4.793431, "o", "\r\n  \u001b[2mBalance and secret never leave the customer. The answer is one boolean.\u001b[0m\r\n"]
[4.793581, "o", "  \u001b[2mOffline, the same four checks agree (true) in 2.1 ms — no\u001b[0m\r\n  \u001b[2mtransaction, no wallet, no trace that anyone asked.\u001b[0m\r\n  \u001b[2mThe same fold on chain takes 20–60 s and leaves a public record. That is\u001b[0m\r\n  \u001b[2mthe point of doing it there: evidence to show someone else, not an answer.\u001b[0m\r\n"]
[6.094466, "o", "\r\n\u001b[1m\u001b[36m4.\u001b[0m  \u001b[1mIssuer republishes a root that drops Carol\u001b[0m\r\n"]
[6.094625, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[6.104019, "o", "  \u001b[2mnew root 569f3acc77309a4b…5be69aeb\u001b[0m\r\n  \u001b[2mdeclared 1,725,700 — 78,000 lower\u001b[0m\r\n\r\n"]
[6.111532, "o", "  Alice    \u001b[32m✓ COVERED\u001b[0m\r\n"]
[6.574462, "o", "  Bob      \u001b[32m✓ COVERED\u001b[0m\r\n"]
[7.03616, "o", "  Carol    \u001b[31m✗ NOT INCLUDED\u001b[0m"]
[7.036235, "o", "\r\n"]
[7.498483, "o", "  Dave     \u001b[32m✓ COVERED\u001b[0m\r\n"]
[7.953144, "o", "\r\n  \u001b[33mCarol detects her own omission. Everyone else is unaffected.\u001b[0m\r\n  \u001b[2mHonest framing: this lets a customer catch being dropped. It does not\u001b[0m\r\n"]
[7.953276, "o", "  \u001b[2mstop an issuer from dropping a customer who never checks.\u001b[0m\r\n"]
[9.903376, "o", "\r\n\u001b[1m\u001b[36m5.\u001b[0m  \u001b[1mIssuer keeps every customer but shaves the total\u001b[0m\r\n"]
[9.903479, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[9.909095, "o", "  \u001b[2msame root bb08141113e1844d…e0f24e91 — nobody removed\u001b[0m\r\n"]
[9.909201, "o", "  \u001b[2mdeclared 1,303,700 instead of 1,803,700\u001b[0m\r\n\r\n"]
[9.917632, "o", "  Alice    \u001b[31m✗ NOT INCLUDED\u001b[0m\r\n"]
[10.381617, "o", "  Bob      \u001b[31m✗ NOT INCLUDED\u001b[0m\r\n"]
[10.843719, "o", "  Carol    \u001b[31m✗ NOT INCLUDED\u001b[0m\r\n"]
[11.305629, "o", "  Dave     \u001b[31m✗ NOT INCLUDED\u001b[0m\r\n"]
[11.760384, "o", "\r\n  \u001b[33mEvery customer catches it — the tree commits to its own total.\u001b[0m\r\n"]
[11.760523, "o", "  \u001b[2mEach node hashes its subtotal alongside its children, so restating\u001b[0m\r\n  \u001b[2mthe sum moves the root. A plain membership tree could not see this.\u001b[0m\r\n"]
[13.712578, "o", "\r\n\u001b[1m\u001b[36m6.\u001b[0m  \u001b[1mA stranger tries to publish\u001b[0m\r\n"]
[13.7127, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n  \u001b[2msame call, same arguments — only the credential differs\u001b[0m\r\n"]
[13.71475, "o", "  \u001b[32mrejected\u001b[0m — failed assert: not the issuer\r\n\r\n  \u001b[2mThe issuer proves it knows the secret behind the commitment fixed at\u001b[0m\r\n  \u001b[2mdeployment. The secret itself never goes on chain.\u001b[0m\r\n"]
[15.02302, "o", "\r\n\u001b[1m\u001b[36m7.\u001b[0m  \u001b[1mAuditor reads the aggregate — auditor_view()\u001b[0m\r\n\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[15.025704, "o", "  declared_liabilities  1,803,700\r\n  solvent               \u001b[32mtrue\u001b[0m\r\n\r\n  \u001b[2mThe aggregate is public by construction — not a privileged view.\u001b[0m\r\n"]
[16.327132, "o", "\r\n\u001b[1m\u001b[36m8.\u001b[0m  \u001b[1mIssuer cannot publish while insolvent\u001b[0m\r\n"]
[16.327437, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n  declaring 1,803,701 against reserves of 1,803,700…\r\n"]
[16.329071, "o", "  \u001b[32mrejected\u001b[0m — failed assert: insolvent\r\n"]
[16.329238, "o", "\r\n\u001b[2mSimplifications, stated plainly: reserves are an attested number, not proven\u001b[0m\r\n\u001b[2mon-chain ownership. The tree does bind its own total, but a customer still\u001b[0m\r\n\u001b[2mhas to check: omission is detectable, not impossible.\u001b[0m\r\n\r\n"]
[16.349984, "o", "\u001b[1G\u001b[0K⠙"]
[16.351353, "o", "\u001b[1G"]
[16.351466, "o", "\u001b[0K"]
