{"version": 2, "width": 84, "height": 70, "timestamp": 1786510598, "idle_time_limit": 3.0, "title": "Candor \u2014 Wave 1 demo"}
[0.103018, "o", "\r\n> candor@0.1.0 demo\r\n> tsx src/demo.ts\r\n\r\n"]
[0.103536, "o", "\u001b[1G"]
[0.103576, "o", "\u001b[0K"]
[0.285779, "o", "\r\n\u001b[1mCANDOR\u001b[0m \u001b[2m— privacy-preserving proof-of-liabilities on Midnight\u001b[0m\r\n"]
[0.285942, "o", "\u001b[2mWave 1 demo · compiled contract, in-process · no proofs generated\u001b[0m\r\n"]
[0.28599, "o", "\r\n\u001b[1m\u001b[36m1.\u001b[0m  \u001b[1mThe issuer's private book\u001b[0m\r\n"]
[0.286037, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[0.301185, "o", "  Alice       1,400,000\r\n"]
[0.301271, "o", "  Bob           320,500\r\n  Carol          78,000\r\n"]
[0.301306, "o", "  Dave            5,200\r\n"]
[0.307578, "o", "  \u001b[2m────────────────────\u001b[0m\r\n"]
[0.307712, "o", "  total       1,803,700\r\n"]
[0.30775, "o", "\r\n  \u001b[2mThis table never leaves the issuer. Only its root is published.\u001b[0m\r\n"]
[1.908951, "o", "\r\n\u001b[1m\u001b[36m2.\u001b[0m  \u001b[1mIssuer publishes — publish_solvency()\u001b[0m\r\n"]
[1.909071, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[1.937464, "o", "  liabilities_root      48904321c82b6722…6e92c7c4\r\n"]
[1.938527, "o", "  declared_liabilities  1,803,700\r\n"]
[1.939515, "o", "  committed_reserves    1,900,000  \u001b[33m[attested, not proven]\u001b[0m\r\n"]
[1.940666, "o", "  solvent               \u001b[32mtrue\u001b[0m\r\n\r\n  \u001b[2mFour public fields. No names, no addresses, no per-customer balances.\u001b[0m\r\n"]
[3.541808, "o", "\r\n\u001b[1m\u001b[36m3.\u001b[0m  \u001b[1mEach customer verifies privately — verify_inclusion()\u001b[0m\r\n"]
[3.541923, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[3.55048, "o", "  Alice    \u001b[32m✓ COVERED\u001b[0m\r\n"]
[4.116335, "o", "  Bob      \u001b[32m✓ COVERED\u001b[0m\r\n"]
[4.682063, "o", "  Carol    \u001b[32m✓ COVERED\u001b[0m\r\n"]
[5.247435, "o", "  Dave     \u001b[32m✓ COVERED\u001b[0m\r\n"]
[5.808292, "o", "\r\n  \u001b[2mBalance and secret stay in the witness. The circuit discloses one boolean.\u001b[0m\r\n"]
[7.410116, "o", "\r\n\u001b[1m\u001b[36m4.\u001b[0m  \u001b[1mIssuer republishes a root that drops Carol\u001b[0m\r\n"]
[7.41022, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[7.416793, "o", "  \u001b[2mnew root 2ef8917e8535e437…a52004a8\u001b[0m\r\n"]
[7.416866, "o", "  \u001b[2mdeclared 1,725,700 — 78,000 lower\u001b[0m\r\n\r\n"]
[7.42052, "o", "  Alice    \u001b[32m✓ COVERED\u001b[0m\r\n"]
[7.985088, "o", "  Bob      \u001b[32m✓ COVERED\u001b[0m\r\n"]
[8.549524, "o", "  Carol    \u001b[31m✗ NOT INCLUDED\u001b[0m\r\n"]
[9.113137, "o", "  Dave     \u001b[32m✓ COVERED\u001b[0m\r\n"]
[9.672888, "o", "\r\n  \u001b[33mCarol detects her own omission. Everyone else is unaffected.\u001b[0m\r\n  \u001b[2mHonest framing: this lets a customer catch being dropped. It does not\u001b[0m\r\n  \u001b[2mstop an issuer from dropping a customer who never checks.\u001b[0m\r\n"]
[12.073396, "o", "\r\n\u001b[1m\u001b[36m5.\u001b[0m  \u001b[1mAuditor reads the aggregate — auditor_view()\u001b[0m\r\n\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[12.075647, "o", "  declared_liabilities  1,725,700\r\n  solvent               \u001b[32mtrue\u001b[0m\r\n"]
[12.075701, "o", "\r\n  \u001b[2mThe aggregate is public by construction — not a privileged view.\u001b[0m\r\n"]
[13.676337, "o", "\r\n\u001b[1m\u001b[36m6.\u001b[0m  \u001b[1mIssuer cannot publish while insolvent\u001b[0m\r\n\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[13.676467, "o", "  declaring 1,803,701 against reserves of 1,803,700…\r\n"]
[13.676607, "o", "  \u001b[32mrejected\u001b[0m — failed assert: insolvent\r\n\r\n\u001b[2mSimplifications, stated plainly: reserves are an attested number, not proven\u001b[0m\r\n"]
[13.676645, "o", "\u001b[2mon-chain ownership. The tree proves membership, not sums — Merkle-SUM is Wave 2.\u001b[0m\r\n\r\n"]
[13.689552, "o", "\u001b[1G\u001b[0K⠙"]
[13.690738, "o", "\u001b[1G"]
[13.690855, "o", "\u001b[0K"]
