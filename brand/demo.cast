{"version": 2, "width": 84, "height": 97, "timestamp": 1786522474, "idle_time_limit": 3.0, "title": "Candor \u2014 Wave 1 demo"}
[0.104252, "o", "\r\n> candor@0.1.0 demo\r\n> tsx src/demo.ts\r\n\r\n"]
[0.104874, "o", "\u001b[1G"]
[0.104926, "o", "\u001b[0K"]
[0.293775, "o", "\r\n\u001b[1mCANDOR\u001b[0m \u001b[2m— privacy-preserving proof-of-liabilities on Midnight\u001b[0m\r\n"]
[0.293964, "o", "\u001b[2mWave 1 demo · compiled contract, in-process · no proofs generated\u001b[0m\r\n"]
[0.294017, "o", "\r\n\u001b[1m\u001b[36m1.\u001b[0m  \u001b[1mThe issuer's private book\u001b[0m\r\n"]
[0.294063, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[0.308294, "o", "  Alice       1,400,000\r\n"]
[0.308417, "o", "  Bob           320,500\r\n"]
[0.308493, "o", "  Carol          78,000\r\n  Dave            5,200\r\n"]
[0.313143, "o", "  \u001b[2m────────────────────\u001b[0m\r\n"]
[0.313314, "o", "  total       1,803,700\r\n"]
[0.313372, "o", "\r\n  \u001b[2mThis table never leaves the issuer. Only its root is published.\u001b[0m\r\n"]
[1.715014, "o", "\r\n\u001b[1m\u001b[36m2.\u001b[0m  \u001b[1mIssuer publishes — publish_solvency()\u001b[0m\r\n"]
[1.715145, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[1.747235, "o", "  liabilities_root      bb08141113e1844d…e0f24e91\r\n"]
[1.748352, "o", "  declared_liabilities  1,803,700\r\n"]
[1.749442, "o", "  committed_reserves    1,900,000  \u001b[33m[attested, not proven]\u001b[0m\r\n"]
[1.750553, "o", "  solvent               \u001b[32mtrue\u001b[0m\r\n\r\n  \u001b[2mFour public fields. No names, no addresses, no per-customer balances.\u001b[0m\r\n"]
[3.152237, "o", "\r\n\u001b[1m\u001b[36m3.\u001b[0m  \u001b[1mEach customer verifies privately — verify_inclusion()\u001b[0m\r\n"]
[3.152408, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[3.160345, "o", "  Alice    \u001b[32m✓ COVERED\u001b[0m\r\n"]
[3.657238, "o", "  Bob      \u001b[32m✓ COVERED\u001b[0m\r\n"]
[4.15451, "o", "  Carol    \u001b[32m✓ COVERED\u001b[0m\r\n"]
[4.650885, "o", "  Dave     \u001b[32m✓ COVERED\u001b[0m\r\n"]
[5.140653, "o", "\r\n  \u001b[2mBalance and secret stay in the witness. The circuit discloses one boolean.\u001b[0m\r\n"]
[6.542455, "o", "\r\n\u001b[1m\u001b[36m4.\u001b[0m  \u001b[1mIssuer republishes a root that drops Carol\u001b[0m\r\n"]
[6.542632, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[6.551342, "o", "  \u001b[2mnew root 569f3acc77309a4b…5be69aeb\u001b[0m\r\n"]
[6.551438, "o", "  \u001b[2mdeclared 1,725,700 — 78,000 lower\u001b[0m\r\n\r\n"]
[6.556525, "o", "  Alice    \u001b[32m✓ COVERED\u001b[0m\r\n"]
[7.051056, "o", "  Bob      \u001b[32m✓ COVERED\u001b[0m\r\n"]
[7.545648, "o", "  Carol    \u001b[31m✗ NOT INCLUDED\u001b[0m\r\n"]
[8.0407, "o", "  Dave     \u001b[32m✓ COVERED\u001b[0m\r\n"]
[8.529959, "o", "\r\n  \u001b[33mCarol detects her own omission. Everyone else is unaffected.\u001b[0m\r\n  \u001b[2mHonest framing: this lets a customer catch being dropped. It does not\u001b[0m\r\n  \u001b[2mstop an issuer from dropping a customer who never checks.\u001b[0m\r\n"]
[10.63005, "o", "\r\n\u001b[1m\u001b[36m5.\u001b[0m  \u001b[1mIssuer keeps every customer but shaves the total\u001b[0m\r\n"]
[10.630182, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[10.636278, "o", "  \u001b[2msame root bb08141113e1844d…e0f24e91 — nobody removed\u001b[0m\r\n"]
[10.636371, "o", "  \u001b[2mdeclared 1,303,700 instead of 1,803,700\u001b[0m\r\n\r\n"]
[10.642098, "o", "  Alice    \u001b[31m✗ NOT INCLUDED\u001b[0m\r\n"]
[11.140512, "o", "  Bob      \u001b[31m✗ NOT INCLUDED\u001b[0m\r\n"]
[11.632291, "o", "  Carol    \u001b[31m✗ NOT INCLUDED\u001b[0m\r\n"]
[12.127876, "o", "  Dave     \u001b[31m✗ NOT INCLUDED\u001b[0m\r\n"]
[12.617657, "o", "\r\n  \u001b[33mEvery customer catches it — the tree commits to its own total.\u001b[0m\r\n  \u001b[2mEach node hashes its subtotal alongside its children, so restating\u001b[0m\r\n"]
[12.617778, "o", "  \u001b[2mthe sum moves the root. A plain membership tree could not see this.\u001b[0m\r\n"]
[14.718363, "o", "\r\n\u001b[1m\u001b[36m6.\u001b[0m  \u001b[1mA stranger tries to publish\u001b[0m\r\n"]
[14.718509, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n  \u001b[2msame call, same arguments — only the credential differs\u001b[0m\r\n"]
[14.720635, "o", "  \u001b[32mrejected\u001b[0m — failed assert: not the issuer\r\n\r\n  \u001b[2mThe issuer proves it knows the secret behind the commitment fixed at\u001b[0m\r\n  \u001b[2mdeployment. The secret itself never goes on chain.\u001b[0m\r\n"]
[16.127889, "o", "\r\n\u001b[1m\u001b[36m7.\u001b[0m  \u001b[1mAuditor reads the aggregate — auditor_view()\u001b[0m\r\n\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[16.130237, "o", "  declared_liabilities  1,803,700\r\n  solvent               \u001b[32mtrue\u001b[0m\r\n"]
[16.130357, "o", "\r\n  \u001b[2mThe aggregate is public by construction — not a privileged view.\u001b[0m\r\n"]
[17.53188, "o", "\r\n\u001b[1m\u001b[36m8.\u001b[0m  \u001b[1mIssuer cannot publish while insolvent\u001b[0m\r\n"]
[17.532011, "o", "\u001b[2m────────────────────────────────────────────────────────────────────────\u001b[0m\r\n  declaring 1,803,701 against reserves of 1,803,700…\r\n"]
[17.533373, "o", "  \u001b[32mrejected\u001b[0m — failed assert: insolvent\r\n\r\n\u001b[2mSimplifications, stated plainly: reserves are an attested number, not proven\u001b[0m\r\n"]
[17.533428, "o", "\u001b[2mon-chain ownership. The tree does bind its own total, but a customer still\u001b[0m\r\n\u001b[2mhas to check: omission is detectable, not impossible.\u001b[0m\r\n\r\n"]
[17.548899, "o", "\u001b[1G\u001b[0K⠙"]
[17.550414, "o", "\u001b[1G"]
[17.550539, "o", "\u001b[0K"]
